{
  "manifest_version": 3,
  "name": "LoRA Manager Free",
  "description": "See if a Civitai model is in your LoRA Manager library, and download it into the folder you pick.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://civitai.com/*", "https://www.civitai.com/*", "https://civitai.red/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "LoRA Manager" }
}
