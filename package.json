{
    "name": "lora-loader-free-extension",
    "version": "2.21.7",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun scripts/build.ts",
        "lint": "shipkit ci --only lint",
        "lint:raw": "oxlint src/ scripts/ tests/",
        "fmt": "oxfmt src/ scripts/ tests/",
        "typecheck": "shipkit ci --only typecheck",
        "typecheck:raw": "tsc --noEmit",
        "hub": "bun --watch node_modules/rvlib-shipkit/src/cli.ts serve",
        "test": "shipkit ci --only test",
        "test:raw": "bun test tests/"
    },
    "devDependencies": {
        "@types/bun": "^1.4.2",
        "@types/chrome": "^0.3.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "oxfmt": "^0.70.0",
        "oxlint": "^1.85.0",
        "rvlib-shipkit": "^1.6.0",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "mobx": "^7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rvlib-mobx": "^1.0.0"
    }
}
