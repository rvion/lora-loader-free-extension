{
    "name": "lora-loader-free-extension",
    "version": "2.21.8",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "bun scripts/build.ts",
        "release:files": "bun scripts/release.ts",
        "typecheck": "shipkit ci --only typecheck",
        "typecheck:raw": "tsc --noEmit",
        "hub": "bun --watch node_modules/rvlib-shipkit/src/cli.ts serve",
        "test": "shipkit ci --only test",
        "test:raw": "bun test tests/"
    },
    "devDependencies": {
        "@napi-rs/canvas": "^1.0.12",
        "@types/bun": "^1.4.2",
        "@types/chrome": "^0.3.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "rvlib-shipkit": "^2.1.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "mobx": "^7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rvlib-mobx": "^1.0.0"
    }
}
